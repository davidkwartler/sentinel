generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  fingerprints    Fingerprint[]
  detectionEvents DetectionEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id              String           @id @default(cuid())
  sessionToken    String           @unique
  userId          String
  expires         DateTime
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprints    Fingerprint[]
  detectionEvents DetectionEvent[]
}

model Fingerprint {
  id           String   @id @default(cuid())
  // Owning user, independent of the session — a detection event's evidence
  // must survive the session it was observed on being deleted (sign-out).
  //
  // Optional at the database level, always written by the application. Making
  // it required would mean `prisma db push` had to add a NOT NULL column with
  // no default to a populated table, which Postgres rejects outright, and would
  // break every insert from the previously-deployed build during the window
  // between migrating and shipping. Nullable removes both hazards: push, deploy,
  // and backfill in any order. See scripts/backfill-user-ownership.mjs.
  userId       String?
  // Optional and SetNull on delete: sign-out deletes the Session row, and this
  // Fingerprint should survive that as an orphaned record, not be cascaded away.
  sessionId    String?
  visitorId    String
  requestId    String   @unique
  ip           String?
  userAgent    String?  @db.Text
  os           String?
  browser      String?
  screenRes    String?
  timezone     String?
  // "verified" | "unresolved" | "unverifiable" | "not_configured" | "unknown".
  // Existing rows default to "unknown" so historical data is never read as verified.
  verification String   @default("unknown")

  // Server-observed detail, promoted out of rawEvent because the comparison
  // table and the prompt read them directly. Null in OSS mode and whenever
  // verification did not resolve — the browser cannot supply any of these.
  osVersion        String?
  browserVersion   String?
  device           String?
  /// Derived from the IP server-side, unlike `timezone`, which the browser
  /// reports about itself and is therefore a claim rather than an observation.
  ipTimezone       String?
  ipCity           String?
  ipCountry        String?
  ipSubdivision    String?
  ipLatitude       Float?
  ipLongitude      Float?
  /// Kilometres. IP geolocation is coarse; distance claims must respect it.
  ipAccuracyRadius Int?
  asn              String?
  asnName          String?
  /// "isp" | "hosting" | "business" | ... — an ISP-to-hosting move is the tell.
  asnType          String?
  /// First and last time Fingerprint saw this visitor on this subscription.
  firstSeenAt      DateTime?
  lastSeenAt       DateTime?
  /// Fingerprint's own 0-100 risk number, independent of Claude's score.
  suspectScore     Int?

  /// The resolved identification event, minus identification.components.
  /// Snapshotted at capture time: Fingerprint's retention window expires, so a
  /// live re-fetch would fail on exactly the historical rows worth inspecting.
  rawEvent     Json?
  isOriginal   Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([visitorId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DetectionEvent {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  // Owning user, independent of the session. Optional at the database level and
  // always written by the application — see Fingerprint.userId for why.
  userId            String?
  // Optional and SetNull: this event is the app's whole output ("we detected
  // this"), so it must outlive the session it was observed on being deleted.
  sessionId         String?
  originalVisitorId String
  newVisitorId      String
  originalIp        String?
  newIp             String?
  // Denormalized copies of what the UI and the Claude prompt render, so this
  // event can resolve its own contents without joining through Fingerprint —
  // which may itself have gone sessionId-null, but more importantly means the
  // event doesn't depend on any other row surviving at all.
  originalOs        String?
  originalBrowser   String?
  originalScreenRes String?
  originalTimezone  String?
  originalUserAgent String?  @db.Text
  newOs             String?
  newBrowser        String?
  newScreenRes      String?
  newTimezone       String?
  newUserAgent      String?  @db.Text
  /// Server-observed location and network, rendered to a line per side rather
  /// than denormalizing fifteen columns twice over. Null unless verification
  /// resolved for that side.
  originalLocation  String?
  originalNetwork   String?
  newLocation       String?
  newNetwork        String?
  similarityScore   Float
  status            String   @default("PENDING")
  confidenceScore   Float?
  reasoning         String?  @db.Text
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session           Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
}
