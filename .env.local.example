# ============================================================
# Sentinel — Local Development Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git (it is in .gitignore).
# ============================================================

# ---- Database (Neon PostgreSQL) ----------------------------
# Get from: https://console.neon.tech
# Create a project -> Connection Details -> copy the "Pooled connection" string.
# Always use the POOLED URL for serverless (not the direct/unpooled variant).
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require"

# ---- Authentication (Auth.js v5 / Google OAuth) ------------
# AUTH_SECRET: Generate with: npm exec auth secret
# Copy the output string. This encrypts session cookies.
AUTH_SECRET="your-generated-secret-here"

# AUTH_GOOGLE_ID + AUTH_GOOGLE_SECRET:
# Get from: https://console.cloud.google.com
# APIs & Services -> Credentials -> Create OAuth 2.0 Client ID (Web application)
# Authorized redirect URI for local: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-client-secret"

# IMPORTANT: Do NOT set NEXTAUTH_URL on Vercel.
# Auth.js v5 auto-infers the URL from Vercel's system environment variables.
# Only set this for local development:
NEXTAUTH_URL="http://localhost:3000"

# ---- FingerprintJS Pro -------------------------------------
# Get from: https://dashboard.fingerprint.com
# Create an application -> copy the Public API Key.
# The NEXT_PUBLIC_ prefix is required — this key loads in the browser.
NEXT_PUBLIC_FINGERPRINT_API_KEY="your-fingerprintjs-public-api-key"

# Secret API key for the Fingerprint Server API (optional but recommended).
# Same dashboard -> API Keys -> Secret API Key. NO NEXT_PUBLIC_ prefix — this
# key must never reach the browser.
# When set, the server resolves each requestId against Fingerprint's API and
# trusts those values over what the browser reported, and passes Smart Signals
# (incognito, VPN, bot, tampering, replay) to the Claude analysis. Without it,
# the client is the only source of truth for its own fingerprint.
FINGERPRINT_SERVER_API_KEY=""

# Region of your Fingerprint application: Global (default), EU, or AP.
FINGERPRINT_REGION="Global"

# ---- Anthropic (Claude AI) ---------------------------------
# Get from: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# Model to use for detection analysis (optional).
# Defaults to claude-haiku-4-5 if not set.
ANTHROPIC_MODEL="claude-haiku-4-5"

# ---- Model Picker UI ----------------------------------------
# Set to "true" to enable the model selector on the profile page.
# When "false" or unset, the picker is greyed out and the server
# ignores any client-side model override (prevents cost abuse).
# Recommended: "true" for local dev, unset for production.
NEXT_PUBLIC_MODEL_PICKER_ENABLED="true"

# ---- Flag Threshold Picker UI --------------------------------
# Set to "true" to enable the flag-threshold slider on the profile page.
# When "false" or unset, the slider is locked and the server ignores any
# client-side threshold override (the session being monitored should not
# set the sensitivity of the monitor). Separate from the model picker flag
# above so screenshots that toggle one don't drag the other along.
# Recommended: "true" for local dev, unset for production.
#
# NEXT_PUBLIC_* values are inlined at build time — a Vercel redeploy that
# restores a cached build will NOT pick up a changed flag; use
# `vercel --prod --force`. And `echo "true" | vercel env add` stores a
# trailing newline that fails `=== "true"` silently — use `printf 'true'`.
NEXT_PUBLIC_THRESHOLD_PICKER_ENABLED="true"

# Fingerprint capture cache TTL, in milliseconds. FingerprintReporter skips
# re-capturing while a cached capture is still within this window. Defaults
# to 30 minutes (1800000) if unset.
NEXT_PUBLIC_FINGERPRINT_TTL_MS="1800000"

# ---- Fingerprint custom subdomain (ad-blocker resistance) -----
# Fingerprint's default agent endpoints are on hostnames that common blocklists
# carry. When they're blocked, Pro capture fails and the app silently falls
# back to an unverifiable client-computed hash. Serving the agent from a
# first-party subdomain avoids that.
#
# Set up under Settings > Subdomains in the Fingerprint dashboard (CNAME + two
# A records), then set both values below. Use a neutral name — "fp" or
# "fingerprint" in the hostname defeats the purpose, since blocklists match on
# hostname. Leave unset in development; the default endpoints are fine there.
#
# NEXT_PUBLIC_FINGERPRINT_ENDPOINT="https://metrics.example.com"
# NEXT_PUBLIC_FINGERPRINT_SCRIPT_URL="https://metrics.example.com/web/v<version>/<apiKey>/loader_v<loaderVersion>.js"
